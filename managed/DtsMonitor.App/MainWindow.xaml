                                        <Button Grid.Column="0"
                                                Width="76"
                                                Style="{StaticResource CompactSecondaryButtonStyle}"
                                                Content="增加"
                                                Click="AddZoneRowButton_Click" />
                                        <Button Grid.Column="2"
                                                Width="88"
                                                Style="{StaticResource CompactSecondaryButtonStyle}"
                                                Content="删除一行"
                                                Click="DeleteZoneRowButton_Click" />
                                        <Button Grid.Column="4"
                                                Width="92"
                                                Style="{StaticResource CompactDangerButtonStyle}"
                                                Content="全部删除"
                                                Click="ClearZoneRowsButton_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="2" Height="206" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="1" Width="96" Style="{StaticResource SecondaryActionButtonStyle}" Content="应用" Click="ApplyZonePresetButton_Click" />
                            <Button Grid.Row="3" Width="96" Style="{StaticResource DialogActionButtonStyle}" Content="确定" Click="ConfirmZoneConfigButton_Click" />
                            <Button Grid.Row="5" Width="96" Style="{StaticResource SecondaryActionButtonStyle}" Content="取消" Click="CloseParameterDialogButton_Click" />
                        </Grid>
                    </Grid>
                </Grid>
                </Viewbox>
            </Border>
        </Grid>
        <Grid x:Name="DeviceManagerDialogOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="#C0040D19">
            <Border MaxWidth="1120"
                    MaxHeight="700"
                    Margin="24"
                    Style="{StaticResource DialogCardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32"
                                      ShadowDepth="0"
                                      Color="#E6000000"
                                      Opacity="0.6" />
                </Border.Effect>
                <Viewbox Stretch="Uniform"
                         StretchDirection="DownOnly"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Grid Width="1020" Height="560">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource DialogTitleStyle}" Text="设备管理" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource DialogCloseButtonStyle}"
                                    Content="×"
                                    Click="CloseDeviceManagerDialogButton_Click" />
                        </Grid>

                        <DataGrid x:Name="DeviceManagerGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  Style="{StaticResource DeviceManagerGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称"
                                                    Width="1.2*"
                                                    Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource DeviceManagerEditableTextStyle}"
                                                    EditingElementStyle="{StaticResource DeviceManagerEditingTextBoxStyle}" />
                                <DataGridTextColumn Header="IP"
                                                    Width="1.6*"
                                                    Binding="{Binding Ip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource DeviceManagerEditableTextStyle}"
                                                    EditingElementStyle="{StaticResource DeviceManagerEditingTextBoxStyle}" />
                                <DataGridCheckBoxColumn Header="启用" Width="0.8*" Binding="{Binding Enabled, Mode=TwoWay}" />
                                <DataGridCheckBoxColumn Header="自动连接" Width="1.0*" Binding="{Binding AutoConnect, Mode=TwoWay}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Width="96"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Content="新增"
                                    Click="AddDeviceButton_Click" />
                            <Button Grid.Column="2"
                                    Width="96"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Content="删除"
                                    Click="RemoveDeviceButton_Click" />
                            <CheckBox x:Name="EnableAllDevicesCheckBox"
                                      Grid.Column="4"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource AppCheckBoxStyle}"
                                      Content="全部启用"
                                      Checked="EnableAllDevicesCheckBox_Checked"
                                      Unchecked="EnableAllDevicesCheckBox_Unchecked" />
                            <Button Grid.Column="6"
                                    Width="96"
                                    Style="{StaticResource DialogActionButtonStyle}"
                                    Content="保存"
                                    Click="SaveDeviceManagerButton_Click" />
                            <Button Grid.Column="8"
                                    Width="96"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Content="关闭"
                                    Click="CloseDeviceManagerDialogButton_Click" />
                        </Grid>
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>
        <Grid x:Name="RuntimeLogDialogOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="#C0040D19">
            <Border MaxWidth="1360"
                    MaxHeight="920"
                    Margin="24"
                    Style="{StaticResource DialogCardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32"
                                      ShadowDepth="0"
                                      Color="#E6000000"
                                      Opacity="0.6" />
                </Border.Effect>
                <Viewbox Stretch="Uniform"
                         StretchDirection="DownOnly"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                <Grid Width="1300" Height="740">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource DialogTitleStyle}" Text="系统日志" />
                        <Button Grid.Column="1"
                                Style="{StaticResource DialogCloseButtonStyle}"
                                Content="×"
                                Click="CloseRuntimeLogDialogButton_Click" />
                    </Grid>

                    <DataGrid x:Name="RuntimeLogGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Style="{StaticResource RuntimeLogGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Width="78" Binding="{Binding Seq}" />
                            <DataGridTextColumn Header="时间" Width="220" Binding="{Binding TimeText}" />
                            <DataGridTextColumn Header="内容"
                                                Width="*"
                                                Binding="{Binding Content}"
                                                ElementStyle="{StaticResource RuntimeLogContentTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                </Viewbox>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</Window>

