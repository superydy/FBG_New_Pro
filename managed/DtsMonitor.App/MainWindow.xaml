<Window x:Class="DtsMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="HG-FBG 本地监控"
        Icon="Assets/AppIcon.ico"
        Height="980"
        Width="1640"
        MinWidth="1280"
        MinHeight="620"
        ResizeMode="CanResize"
        WindowState="Maximized"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        SizeChanged="MainWindow_SizeChanged"
        StateChanged="MainWindow_StateChanged"
        Closing="Window_Closing"
        Background="#04162F">
    <Window.Resources>
        <x:Array x:Key="FixedTempThresholdOptions" Type="{x:Type sys:Double}">
            <sys:Double>60</sys:Double>
            <sys:Double>70</sys:Double>
            <sys:Double>85</sys:Double>
            <sys:Double>105</sys:Double>
            <sys:Double>138</sys:Double>
            <sys:Double>180</sys:Double>
        </x:Array>
        <x:Array x:Key="RateThresholdOptions" Type="{x:Type sys:Double}">
            <sys:Double>10</sys:Double>
            <sys:Double>20</sys:Double>
            <sys:Double>30</sys:Double>
        </x:Array>
        <SolidColorBrush x:Key="AppBgBrush" Color="#04162F" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#0A2142" />
        <SolidColorBrush x:Key="CardBgSoftBrush" Color="#102B52" />
        <SolidColorBrush x:Key="BorderBrushPrimary" Color="#2E5A8F" />
        <SolidColorBrush x:Key="BorderBrushAccent" Color="#4B88D9" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E9F5FF" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9EC8FF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1E5FA8" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2873C7" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#174A80" />
        <SolidColorBrush x:Key="MutedButtonBrush" Color="#18355F" />
        <SolidColorBrush x:Key="DangerBrush" Color="#7A2742" />

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#6611274A" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushPrimary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E9F5FF" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9EC8FF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ControlFieldLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="#9EC8FF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E9F5FF" />
            <Setter Property="Background" Value="#0D2A55" />
            <Setter Property="BorderBrush" Value="#3C73B3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#E9F5FF" />
            <Setter Property="SelectionBrush" Value="#2873C7" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#133663" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#7EB7FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#7EB7FF" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0A2241" />
                                <Setter Property="Foreground" Value="#9EC8FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControlFieldInputStyle" TargetType="TextBox" BasedOn="{StaticResource FieldInputStyle}">
            <Setter Property="Width" Value="148" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AcquisitionFieldInputStyle" TargetType="TextBox" BasedOn="{StaticResource ControlFieldInputStyle}">
            <Setter Property="Padding" Value="4,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#133663" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#7EB7FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#7EB7FF" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0A2241" />
                                <Setter Property="Foreground" Value="#9EC8FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushAccent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#7EB7FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Background" Value="#153964" />
            <Setter Property="BorderBrush" Value="#2E6BAF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource MutedButtonBrush}" />
            <Setter Property="BorderBrush" Value="#36689D" />
        </Style>

        <Style x:Key="DangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="#B65D78" />
        </Style>

        <Style x:Key="AppCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MainViewContentOnlyTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="#03132C" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushPrimary}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,8,8,8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Margin="0"
                                              ContentSource="SelectedContent" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainViewSwitchButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="#0C2344" />
            <Setter Property="BorderBrush" Value="#2A537F" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8,8,0,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#113054" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#3E74AE" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#163D6A" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#5E97E2" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="HistoryCalendarPrevButtonTemplate" TargetType="Button">
            <Border x:Name="NavRoot"
                Width="28"
                Height="24"
                Background="#12355C"
                BorderBrush="#5E98E6"
                BorderThickness="1"
                CornerRadius="7">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#EAF4FF"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="‹"
                           Margin="0,-2,0,0" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="NavRoot" Property="Background" Value="#1A497A" />
                    <Setter TargetName="NavRoot" Property="BorderBrush" Value="#8BC7FF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="NavRoot" Property="Background" Value="#0E2C4D" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="HistoryCalendarNextButtonTemplate" TargetType="Button">
            <Border x:Name="NavRoot"
                Width="28"
                Height="24"
                Background="#12355C"
                BorderBrush="#5E98E6"
                BorderThickness="1"
                CornerRadius="7">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#EAF4FF"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="›"
                           Margin="0,-2,0,0" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="NavRoot" Property="Background" Value="#1A497A" />
                    <Setter TargetName="NavRoot" Property="BorderBrush" Value="#8BC7FF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="NavRoot" Property="Background" Value="#0E2C4D" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="HistoryCalendarHeaderButtonTemplate" TargetType="Button">
            <Border x:Name="HeaderRoot"
                    Height="28"
                    Margin="8,0"
                    Background="#0F2A49"
                    BorderBrush="#3D6FA5"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,0">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="HeaderRoot" Property="Background" Value="#16385F" />
                    <Setter TargetName="HeaderRoot" Property="BorderBrush" Value="#6FAEF4" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="HeaderRoot" Property="Background" Value="#0E2742" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="HistoryCalendarItemStyle" TargetType="{x:Type primitives:CalendarItem}">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:CalendarItem}">
                        <ControlTemplate.Resources>
                            <DataTemplate x:Key="DayTitleTemplate">
                                <TextBlock Text="{Binding}"
                                           Foreground="#CFE6FF"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,4,0,6" />
                            </DataTemplate>
                        </ControlTemplate.Resources>

                        <Grid x:Name="PART_Root">
                            <Border Background="#0B1D39"
                                    BorderBrush="#7EB7FF"
                                    BorderThickness="0"
                                    CornerRadius="8">
                                <Grid Margin="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="PART_PreviousButton"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Width="28"
                                            Height="24"
                                            Margin="2,4,2,4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Focusable="False"
                                            Template="{StaticResource HistoryCalendarPrevButtonTemplate}" />

                                    <Button x:Name="PART_HeaderButton"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Width="132"
                                            Height="28"
                                            Margin="0,2"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="#F3F9FF"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Focusable="False"
                                            Template="{StaticResource HistoryCalendarHeaderButtonTemplate}" />

                                    <Button x:Name="PART_NextButton"
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Width="28"
                                            Height="24"
                                            Margin="2,4,2,4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Focusable="False"
                                            Template="{StaticResource HistoryCalendarNextButtonTemplate}" />

                                    <Grid Grid.Row="1"
                                          Grid.ColumnSpan="3"
                                          Width="238"
                                          Margin="0,2,0,0"
                                          HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="一"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#CFE6FF"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="二"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#CFE6FF"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2"
                                                   Text="三"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#CFE6FF"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3"
                                                   Text="四"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#CFE6FF"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="4"
                                                   Text="五"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#CFE6FF"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="5"
                                                   Text="六"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#CFE6FF"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="6"
                                                   Text="日"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#CFE6FF"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                    </Grid>

                                    <Grid x:Name="PART_MonthView"
                                          Grid.Row="2"
                                          Grid.ColumnSpan="3"
                                          Margin="6,4,6,6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Top"
                                          Visibility="Visible">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="0" />
                                            <RowDefinition Height="32" />
                                            <RowDefinition Height="32" />
                                            <RowDefinition Height="32" />
                                            <RowDefinition Height="32" />
                                            <RowDefinition Height="32" />
                                            <RowDefinition Height="32" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>

                                    <Grid x:Name="PART_YearView"
                                          Grid.Row="2"
                                          Grid.ColumnSpan="3"
                                          Margin="6,8,6,6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Top"
                                          Visibility="Hidden">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="40" />
                                            <RowDefinition Height="40" />
                                            <RowDefinition Height="40" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Rectangle x:Name="PART_DisabledVisual"
                                       Visibility="Collapsed"
                                       RadiusX="8"
                                       RadiusY="8"
                                       Fill="#66FFFFFF" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" Value="Year">
                                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" Value="Decade">
                                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryCalendarDayButtonStyle" TargetType="{x:Type primitives:CalendarDayButton}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:CalendarDayButton}">
                        <Border x:Name="DayRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayRoot" Property="Background" Value="#153964" />
                                <Setter TargetName="DayRoot" Property="BorderBrush" Value="#5E98E6" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DayRoot" Property="Background" Value="#1D4F86" />
                                <Setter TargetName="DayRoot" Property="BorderBrush" Value="#8BC7FF" />
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="#6F86A8" />
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="DayRoot" Property="BorderBrush" Value="#7FD0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryCalendarButtonStyle" TargetType="{x:Type primitives:CalendarButton}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:CalendarButton}">
                        <Border x:Name="HeaderRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="4,2">
